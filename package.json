{
  "name": "factorio-lamp-editor",
  "private": true,
  "version": "1.6.9",
  "description": "Create Factorio lamp blueprints from images, slideshows, GIFs, and videos.",
  "license": "UNLICENSED",
  "author": "Factorio Lamp Editor contributors",
  "keywords": [
    "factorio",
    "blueprint",
    "lamp",
    "pixel-art",
    "gif",
    "electron"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "factorio-lamp-editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:blueprint": "esbuild scripts/validate-blueprint-preview.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-preview-test.mjs && node node_modules/.cache/factorio-lamp-preview-test.mjs",
    "test:media": "esbuild scripts/validate-media-animation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-media-test.mjs && node node_modules/.cache/factorio-lamp-media-test.mjs",
    "test:media-decoder": "node scripts/validate-media-decoder.cjs",
    "test:audio": "node scripts/validate-audio-decoder.cjs && node scripts/validate-factorio-sounds.cjs",
    "test:fonts": "esbuild scripts/validate-font-assets.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-font-test.mjs && node node_modules/.cache/factorio-lamp-font-test.mjs",
    "test:i18n": "esbuild scripts/validate-i18n.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-i18n-test.mjs && node node_modules/.cache/factorio-lamp-i18n-test.mjs",
    "test:morning": "esbuild scripts/validate-morning-blueprint.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-morning-test.mjs && node --max-old-space-size=6144 node_modules/.cache/factorio-lamp-morning-test.mjs",
    "test:system-fonts": "node scripts/validate-system-fonts.cjs",
    "test:timing": "esbuild scripts/validate-scroll-timing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-timing-test.mjs && node node_modules/.cache/factorio-lamp-timing-test.mjs",
    "test:text-stamp": "esbuild scripts/validate-text-stamp-animation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-text-stamp-test.mjs && node node_modules/.cache/factorio-lamp-text-stamp-test.mjs",
    "test:animated-emoji": "node scripts/validate-noto-animated-emoji.cjs",
    "test:emoji-cache": "node scripts/validate-emoji-cache.cjs",
    "test:tgs": "esbuild scripts/validate-tgs-document.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/factorio-lamp-tgs-test.mjs && node node_modules/.cache/factorio-lamp-tgs-test.mjs",
    "test:modern-media": "node scripts/validate-modern-media-formats.cjs",
    "test:browser-image-codecs": "esbuild scripts/validate-browser-image-codecs.ts --bundle --platform=browser --format=iife --outfile=node_modules/.cache/factorio-lamp-browser-codec-test.js && electron scripts/validate-browser-image-codecs.cjs",
    "test:tgs-renderer": "esbuild scripts/validate-tgs-renderer.ts --bundle --platform=browser --format=iife --outfile=node_modules/.cache/factorio-lamp-tgs-renderer-test.js && electron scripts/validate-tgs-renderer.cjs",
    "sync:animated-emoji": "node scripts/sync-noto-animated-emoji.cjs",
    "sync:fluent-emoji": "node scripts/sync-fluent-emoji-manifest.cjs",
    "test:ci": "npm run test:blueprint && npm run test:media && npm run test:audio && npm run test:fonts && npm run test:i18n && npm run test:system-fonts && npm run test:timing && npm run test:text-stamp && npm run test:animated-emoji && npm run test:emoji-cache && npm run test:tgs && npm run test:modern-media",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win portable --publish never",
    "desktop:portable": "npm run build && electron-builder --win portable --publish never",
    "desktop:linux": "npm run build && node scripts/prepare-linux-ffmpeg.cjs && electron-builder --linux --x64 --publish never && node scripts/validate-appimage-runtime.cjs"
  },
  "build": {
    "appId": "com.jojkos.factoriolampeditor",
    "productName": "Factorio Lamp Editor",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/favicon/android-chrome-512x512.png",
        "to": "app-icon.png"
      },
      {
        "from": "public/licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "afterPack": "scripts/electron-builder-hooks.cjs",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/favicon/android-chrome-512x512.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
          "to": "ffmpeg/COPYING.GPLv3.txt"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
          "to": "ffmpeg/BUILD-AND-SOURCE.txt"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics",
      "syncDesktopName": true,
      "icon": "public/favicon/android-chrome-512x512.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build-resources/ffmpeg/linux-x64/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "build-resources/ffmpeg/linux-x64/COPYING.GPLv3.txt",
          "to": "ffmpeg/COPYING.GPLv3.txt"
        },
        {
          "from": "build-resources/ffmpeg/linux-x64/BUILD-AND-SOURCE.txt",
          "to": "ffmpeg/BUILD-AND-SOURCE.txt"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Factorio Lamp Editor"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "lottie-web": "^5.13.0",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
